<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartTaskTracker.ViewModel"
             x:Class="SmartTaskTracker.AddToDoPage"
             Title="Add Task">


    <VerticalStackLayout Padding="20">
        <Entry Text="{Binding NewToDo.Name}" Placeholder="Title" />
        <Editor Text="{Binding NewToDo.Description}" Placeholder="Description" />
        <DatePicker Date="{Binding NewToDo.DueDate}" />
        <Picker ItemsSource="{Binding Priorities}"
                SelectedItem="{Binding NewToDo.Priority}"
                Title="Select Priority" />
        <Button Text="Save Task" Command="{Binding SaveCommand}" />

        <!--<Entry x:Name="TitleEntry" Placeholder="Title" />
        <Editor x:Name="DescriptionEditor" Placeholder="Description" />
        <DatePicker x:Name="DueDatePicker" />
        <Picker x:Name="PriorityPicker" Title="Select Priority" />
        <Button Text="Save Changes" Clicked="OnSaveClicked" />-->

    </VerticalStackLayout>
</ContentPage>